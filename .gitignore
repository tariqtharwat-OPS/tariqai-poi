# Ignore everything
*

# Allow directories themselves (must be done recursively)
!/src/
!/src/poi/
!/src/poi/**

!/src/tests/
!/src/tests/**

!/persistent_memory/
!/persistent_memory/poi/
!/persistent_memory/poi/audit_trail.log

# Allow root governance and documentation files
!/TARIQ_AI_CONSTITUTION.md
!/INTELLIGENCE_CORE_SPEC.md
!/SYSTEM_BOUNDARIES.md
!/README.md
!/REALITY_CHECK_REPORT.md
!/TECH_STACK_REVIEW.md
!/EXECUTION_SAFETY_AUDIT.md
!/KNOWN_ISSUES.md
!/REPRODUCIBILITY.md
!/requirements.txt
!/.gitignore

# Exclude python clutter even in whitelisted folders
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.venv/
.env
.pytest_cache/
*.log
